---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Tags from '../components/Tags.astro';

const entries = (await getCollection('briefings')).sort((a,b) => b.data.date.valueOf() - a.data.date.valueOf());
const grouped = new Map();
for (const entry of entries) {
  const key = entry.data.date.toLocaleDateString('en-US', {year:'numeric', month:'long'});
  if (!grouped.has(key)) grouped.set(key, []);
  grouped.get(key).push(entry);
}
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Archive" description="Browse and search the Daily Side-Channel archive.">
  <div class="shell">
    <header class="archive-head">
      <div class="kicker">all transmissions</div>
      <h1>archive</h1>
      <p>Search the full archive by idea, artifact, process, or rabbit hole. The archive is deliberately plain text underneath the machinery.</p>
      <div class="archive-controls">
        <input id="archive-search" class="search" type="search" placeholder="search everything…" autocomplete="off" />
      </div>
    </header>
    <div id="archive-list">
      {[...grouped].map(([month, monthEntries]) => (
        <section class="month">
          <h2>{month}</h2>
          {monthEntries.map((entry) => (
            <article class="archive-item" data-id={entry.id}>
              <div class="archive-date">{entry.data.date.toLocaleDateString('en-US',{month:'short',day:'2-digit',year:'numeric'})}</div>
              <div>
                <h3><a href={`${base}briefings/${entry.id}/`}>{entry.data.title}</a></h3>
                <p>{entry.data.summary}</p>
                <Tags tags={entry.data.tags} />
              </div>
            </article>
          ))}
        </section>
      ))}
    </div>
    <div id="empty-state" class="empty-state">nothing in the archive matches that particular tunnel.</div>
  </div>
  <script define:vars={{base}}>
    const input = document.querySelector('#archive-search');
    const items = [...document.querySelectorAll('.archive-item')];
    const months = [...document.querySelectorAll('.month')];
    const empty = document.querySelector('#empty-state');
    let index = [];
    fetch(`${base}search-index.json`).then(r => r.json()).then(data => { index = data; });
    function apply() {
      const q = input.value.trim().toLowerCase();
      let visible = 0;
      for (const item of items) {
        const record = index.find(x => x.id === item.dataset.id);
        const hit = !q || (record && record.haystack.includes(q));
        item.hidden = !hit;
        if (hit) visible++;
      }
      for (const month of months) {
        month.hidden = ![...month.querySelectorAll('.archive-item')].some(x => !x.hidden);
      }
      empty.style.display = visible ? 'none' : 'block';
    }
    input.addEventListener('input', apply);
  </script>
</BaseLayout>
