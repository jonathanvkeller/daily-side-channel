---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Tags from '../../components/Tags.astro';

export async function getStaticPaths() {
  const entries = (await getCollection('briefings')).sort((a,b)=>a.data.date.valueOf()-b.data.date.valueOf());
  return entries.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, prev: entries[i-1] ?? null, next: entries[i+1] ?? null }
  }));
}
const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
const base = import.meta.env.BASE_URL;
const dateFmt = entry.data.date.toLocaleDateString('en-US', {year:'numeric',month:'long',day:'numeric'});
---
<BaseLayout title={entry.data.title} description={entry.data.summary}>
  <div class="shell article-grid">
    <aside class="margin-note">
      <div class="kicker">archive transmission</div>
      <div class="issue-meta">{dateFmt}</div>
      <Tags tags={entry.data.tags} />
      <p><a href={`${base}archive/`}>← archive</a></p>
    </aside>
    <article>
      <h1>{entry.data.title}</h1>
      <Content />
      <nav class="issue-nav" aria-label="Issue navigation">
        <span>{prev && <a href={`${base}briefings/${prev.id}/`}>← {prev.data.date.toLocaleDateString('en-US',{month:'short',day:'numeric'})}</a>}</span>
        <span>{next && <a href={`${base}briefings/${next.id}/`}>{next.data.date.toLocaleDateString('en-US',{month:'short',day:'numeric'})} →</a>}</span>
      </nav>
    </article>
  </div>
</BaseLayout>
